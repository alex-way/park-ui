{
  "name": "@park-ui/svelte",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "panda codegen --clean --silent",
    "dev": "bun run storybook",
    "lint": "biome lint ./src",
    "storybook": "storybook dev -p 6006",
    "typecheck": "tsc",
    "registry:prepare": "scripts registry prepare --name @park-ui/svelte",
    "registry:build": "scripts registry build svelte",
    "typedoc": "scripts typedoc --out ../../website/public/types/svelte"
  },
  "exports": {
    "./examples": "./src/examples/index.ts",
    ".": "./src/components/ui/index.ts"
  },
  "dependencies": {
    "@ark-ui/svelte": "5.15.0"
  },
  "devDependencies": {
    "@lucide/svelte": "0.562.0",
    "@pandacss/dev": "1.7.0",
    "@pandacss/preset-base": "1.7.0",
    "@pandacss/preset-panda": "1.7.0",
    "@park-ui/preset": "workspace:*",
    "@park-ui/scripts": "workspace:*",
    "@storybook/addon-a11y": "10.1.8",
    "@storybook/addon-svelte-csf": "5.0.6",
    "@storybook/addon-themes": "10.1.8",
    "@storybook/svelte": "10.1.8",
    "@storybook/svelte-vite": "10.1.8",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "storybook": "10.1.8",
    "svelte": "5.46.1",
    "typescript": "5.9.3",
    "vite": "7.2.7",
    "vite-tsconfig-paths": "5.1.4"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
